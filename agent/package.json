{
  "name": "smasage-agent",
  "version": "1.0.0",
  "description": "Smasage AI Agent using OpenClaw framework",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env index.js",
    "notifications": "node --loader ts-node/esm notification-monitor.ts",
    "test": "jest --config jest.config.cjs",
    "test:smoke": "node --loader ts-node/esm test-notifications.ts",
    "build": "tsc",
    "read-balances": "node --loader ts-node/esm balance-reader.ts"
  },
  "dependencies": {
    "openclaw": "^2026.3.13",
    "dotenv": "^16.4.5",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^11.2.0",
    "@types/jest": "^30.0.0",
    "@types/ws": "^8.5.8",
    "@types/node": "^20.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0"
  },
  "overrides": {
    "protobufjs": "^7.5.4",
    "axios": "^1.13.6",
    "hono": "^4.12.7"
  }
}